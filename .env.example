DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
DSH_SERVER_PUBLIC_URL=http://localhost:8080
DSH_SERVER_DATA_FILE=./data/state.json

# WebRTC data plane (LAN -> P2P -> TURN -> Relay). Set to 0 to force Relay only.
DSH_SERVER_WEBRTC=1
# STUN endpoints used to discover the peer public address for hole punching.
# Built-in default: stun:stun.miwifi.com:3478,stun:stun.cloudflare.com:3478
# Set empty to disable STUN entirely.
# DSH_SERVER_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.cloudflare.com:3478
# Probe the configured STUN endpoints at startup and try the fastest reachable
# one first. Set to 0 if the host must not send diagnostic UDP.
DSH_SERVER_STUN_PROBE=1
# TURN endpoints used when hole punching fails. Empty keeps the Server STUN-only.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
DSH_SERVER_TURN_URLS=
# coturn shared secret (static-auth-secret / use-auth-secret). Preferred.
DSH_SERVER_TURN_SECRET=
# Alternative to the shared secret: static TURN credentials.
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=
# Lifetime of generated TURN credentials in seconds (60-86400).
DSH_SERVER_TURN_TTL=3600
