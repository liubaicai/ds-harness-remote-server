{
  "name": "ds-harness-remote-server",
  "version": "0.5.20",
  "private": true,
  "type": "module",
  "description": "Self-hosted Server for DS Harness Remote: device pairing, Control channel, WebRTC brokering (LAN → P2P → TURN → Relay) and STUN/TURN credentials.",
  "homepage": "https://github.com/liubaicai/ds-harness-remote-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liubaicai/ds-harness-remote-server.git"
  },
  "bugs": {
    "url": "https://github.com/liubaicai/ds-harness-remote-server/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@lukeburns/clatterjs": "1.0.0",
    "@noble/ciphers": "^1.1.3",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
